<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <!-- lightning__FlowScreen makes this component available as a Screen
         element inside Screen Flows. This is what creates the hard dependency:
         any Flow that drops this component onto a screen stores this component's
         name in its Flow XML, and Salesforce validates that name on every deploy. -->
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="selectedStatus" type="String" label="Selected Status"
                      description="Captures the status the user picks. Map this to a Flow variable." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
