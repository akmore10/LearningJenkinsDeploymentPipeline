<?xml version="1.0" encoding="UTF-8"?>
<!--
  Combined single-command strategy:
    1. Deploy  → this file pushes the updated Flow (LWC reference removed)
    2. Delete  → destructiveChanges-lwc-only.xml removes orderStatusPicker

  Salesforce guarantees post-destructive changes run AFTER the deploy
  completes, so by the time it tries to delete orderStatusPicker the Flow
  no longer holds <extensionName>c:orderStatusPicker</extensionName>.

  Jenkins single command:
    sf deploy metadata \
      --manifest manifest/package-flow-update.xml \
      --post-destructive-changes manifest/destructiveChanges-lwc-only.xml \
      --target-org ${TARGET_ORG}

  NOTE: Rename Order_Management_Flow_Without_LWC.flow-meta.xml back to
  Order_Management_Flow.flow-meta.xml before running — the API name in the
  filename must match the Flow's <label> / existing Flow in the org.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- Deploy the updated Flow — LWC screen element replaced with TextInput.
         This removes <extensionName>c:orderStatusPicker</extensionName>
         from the org before the post-destructive step runs. -->
    <types>
        <members>Order_Management_Flow</members>
        <name>Flow</name>
    </types>

    <version>67.0</version>
</Package>
