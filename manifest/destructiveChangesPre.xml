<?xml version="1.0" encoding="UTF-8"?>
<!--
  ╔══════════════════════════════════════════════════════════════════════════╗
  ║  PRE-DESTRUCTIVE CHANGES  (consumers — deleted FIRST)                   ║
  ╚══════════════════════════════════════════════════════════════════════════╝

  These components are at the TOP of the dependency chain. Nothing below them
  in the org depends on them, so they are safe to remove before anything else.

  Dependency chain being torn down (top → bottom):

    orderDashboard (LWC)
      ↓ imports from @salesforce/apex/OrderController.*
    OrderController (Apex)
      ↓ calls OrderService.*
    OrderService (Apex)
      ↓ queries OrderSummary__c, selects Status__c
    OrderSummary__c.Status__c (Custom Field)
      ↓ field belongs to
    OrderSummary__c (Custom Object)

  WHY SPLIT INTO PRE vs POST?
  ─────────────────────────────
  If you put OrderController in destructiveChangesPost.xml but leave
  OrderService in the org (not yet deleted), Salesforce recompiles
  OrderController during the post-delete validation and finds OrderService
  still present — that's fine. But if you accidentally leave out
  OrderController and only delete OrderService, Salesforce will throw:

    "OrderController: Variable does not exist: OrderService"

  The safest strategy for a Jenkins pipeline is:
    1. Pre-destructive  → delete consumers (this file)
    2. Post-destructive → delete providers (destructiveChangesPost.xml)

  This guarantees that by the time providers are removed, nothing in the
  org still references them.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- Step 1: Delete the LWC first — it imports from OrderController.
         Once gone, OrderController has no remaining callers in the org. -->
    <types>
        <members>orderDashboard</members>
        <name>LightningComponentBundle</name>
    </types>

    <!-- Step 2: Delete OrderController — it calls OrderService methods.
         Once gone, OrderService has no remaining callers in the org. -->
    <types>
        <members>OrderController</members>
        <name>ApexClass</name>
    </types>

    <version>67.0</version>
</Package>
