<?xml version="1.0" encoding="UTF-8"?>
<!--
  ╔══════════════════════════════════════════════════════════════════════════╗
  ║  APPROACH A — Delete both the Flow AND the LWC                          ║
  ╚══════════════════════════════════════════════════════════════════════════╝

  Use this when neither the Flow nor the LWC is needed anymore.

  Dependency rule:
    Flow (consumer) must be deleted BEFORE the LWC (provider).
    The Flow XML embeds <extensionName>c:orderStatusPicker</extensionName>.
    If the LWC disappears first, the still-existing Flow becomes invalid and
    Salesforce will refuse any subsequent deploy that touches the org's Flow
    metadata — even unrelated Flows — until the broken reference is fixed.

  HOW TO USE IN JENKINS:
    Use this as --pre-destructive-changes alongside an empty package.xml.

    sf deploy metadata \
      --manifest manifest/package.xml \
      --pre-destructive-changes manifest/destructiveChanges-flow-and-lwc.xml \
      --target-org ${TARGET_ORG}

  The Flow is deleted first (pre-step), then the LWC reference it held is
  gone — so Salesforce has no orphaned reference to complain about.

  NOTE ON FLOW STATUS:
    Salesforce will NOT let you delete an Active Flow version via metadata
    deploy. You must either:
      a) Deploy the Flow with <status>Obsolete</status> first, then delete it, OR
      b) Deactivate it manually in Setup → Flows before running this pipeline.
    The Jenkins stage should check flow status or include a deactivation step.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- Step 1 (Pre): Delete the Flow first — it holds the LWC reference.
         Once gone, the LWC has no remaining consumers. -->
    <types>
        <members>Order_Management_Flow</members>
        <name>Flow</name>
    </types>

    <!-- Step 2 (Pre): Now safe to delete the LWC — nothing references it. -->
    <types>
        <members>orderStatusPicker</members>
        <name>LightningComponentBundle</name>
    </types>

    <version>67.0</version>
</Package>
